{
  "name": "onspot-desktop",
  "productName": "OnSpot",
  "version": "2.1.1",
  "description": "OnSpot for Windows: share files, text and clipboard with your phone over local Wi-Fi",
  "main": "src/main.js",
  "author": "BoopathiRaja Kannan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iboopathiraja/OnSpot-File-Sharing-Tool.git",
    "directory": "desktop"
  },
  "homepage": "https://github.com/iboopathiraja/OnSpot-File-Sharing-Tool#readme",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.beyondzero.onspot.desktop",
    "productName": "OnSpot",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OnSpot"
    },
    "afterPack": "build/after-pack.js"
  }
}
